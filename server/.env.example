# --- server ---
PORT=8000
DB_PATH=/opt/newspush/server/data/newspush.db
POLL_ENABLED=true
POLL_TICK_SECONDS=30
MAX_CONCURRENT_FETCHES=3
BILI_MIN_INTERVAL_SECONDS=2.0
POST_RETENTION_DAYS=90

# --- device registration ---
# open | invite
REGISTRATION_MODE=open
INVITE_CODE=
DEVICE_HOUR_LIMIT=60
DEVICE_DAY_LIMIT=500
REGISTER_IP_HOUR_LIMIT=5
REGISTER_IP_DAY_LIMIT=20

# --- admin ---
# Leave empty to disable HTTP admin endpoints (CLI still works)
ADMIN_TOKEN=

# --- bilibili ---
# Optional: a dedicated account's SESSDATA cookie, improves space API success rate
BILI_SESSDATA=
